# Configuración del proyecto — Elige UN proveedor de IA
# Copia este archivo como .env y completa tu API key

# --- Opción 1: Google Gemini (gratuito en Google AI Studio) ---
IA_PROVIDER=gemini
GEMINI_API_KEY=tu-api-key-de-google-ai-studio
GEMINI_MODEL=gemini-2.0-flash      # o gemini-1.5-pro, gemini-2.5-flash

# --- Opción 2: OpenAI ---
# IA_PROVIDER=openai
# OPENAI_API_KEY=sk-tu-api-key
# OPENAI_MODEL=gpt-4o-mini
